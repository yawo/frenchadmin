DATA_GOUV_DATASETS_CATALOG_FOLDER=data/unprocessed/data_gouv_datasets_catalog
DOLE_DATA_FOLDER=data/unprocessed/dole
LEGI_DATA_FOLDER=data/unprocessed/legi
JADE_DATA_FOLDER=data/unprocessed/jade
BOFIP_DATA_FOLDER=data/unprocessed/bofip
TRAVAIL_EMPLOI_DATA_FOLDER=data/unprocessed/travail_emploi
SERVICE_PUBLIC_PRO_DATA_FOLDER=data/unprocessed/service_public_pro
SERVICE_PUBLIC_PART_DATA_FOLDER=data/unprocessed/service_public_part

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=mediatech
POSTGRES_USER=user
POSTGRES_PASSWORD=password

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD= # Optional: set when FalkorDB auth is enabled
FALKORDB_GRAPH_NAME=frenchadmin # Name of the knowledge graph in FalkorDB

AIRFLOW_UID= echo $(id -u)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
JWT_TOKEN=jwt__user_token_obtained_from_airflow_api
PROJECT_DIR=/home/example/project/dir/

RETENTION_DAYS=7 # Number of days to retain old files (logs, backups etc...)

API_KEY=api_key
API_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

RERANKER_MODEL=BAAI/bge-reranker-v2-m3 # Cross-encoder for relevance reranking
RERANKER_MAX_LENGTH=1024 # Max tokens the reranker sees per document (model supports up to 8192)
RERANKER_MIN_SCORE=0.01 # Minimum sigmoid-normalized reranker score to keep a result
RETRIEVAL_OVERSAMPLING_FACTOR=4 # Oversample factor before reranking (top_k * factor candidates)

ENABLE_HYBRID_SEARCH=true # Combine vector search with PostgreSQL full-text search via RRF
RRF_K=60 # RRF smoothing constant (higher = more uniform blending)
FTS_WEIGHT=1.0 # Relative weight of FTS results vs vector in RRF fusion

EMBEDDING_MODEL=BAAI/bge-m3 # Robust multilingual long-context embedding model (1024-dim, up to 8192 tokens)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True # Helps reduce CUDA fragmentation
EMBEDDING_ENCODE_BATCH_SIZE=8 # Lower to reduce peak VRAM per encode pass
EMBEDDING_BATCH_MAX_SIZE=32 # Logical chunk-text batch for recursive retry helper
EMBEDDING_MAX_INPUT_TOKENS=7800 # Hard cap before encode to avoid unstable long-sequence embeddings
# EMBEDDING_NONFINITE_FALLBACK_MODEL= # Optional. Leave empty unless you intentionally recreate tables for a fallback model with the same vector dimension.
CHUNK_SIZE=7500 # Larger chunks keep more full-law context when possible
CHUNK_OVERLAP=500 # Preserve legal context continuity across chunks
CHUNK_MIN_FILL_RATIO=0.70 # Merge underfilled chunks when legal separators split too early

HF_TOKEN=hf_token
FERNET_KEY=WTV4llCkyF0gjdn3YExmoYjnwgMDmneZ0Q8t0fJnIs0=
JWT_SECRET=change-me-in-productio



TCHAP_ACCOUNT_TOKEN=tchap_account_token # Optionnal
TCHAP_ROOM_TOKEN=tchap_room_token # Optionnal
TCHAP_SERVER=tchap_server_url # Optionnal
